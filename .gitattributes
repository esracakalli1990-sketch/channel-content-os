# Metin dosyalarinda satir sonlarini normalize et (checkout'ta platforma gore)
* text=auto eol=lf

# Windows'a ozgu betikler CRLF kalsin
*.bat text eol=crlf
*.ps1 text eol=crlf

# Ikili dosyalar dokunulmasin
*.mp4 binary
*.mp3 binary
*.jpg binary
*.png binary

# Iki is ayni anda yaziyor (fikir isi ve Telegram dinleyicisi); metin olarak
# degil liste/sozluk olarak birlestirilir. Surucu: src/channel_ops/state_merge.py
data/shorts_pending.json merge=shorts-state
data/shorts_history.json merge=shorts-state
