# Channel Content OS — ortam degiskenleri sablonu
# Bu dosyayi `.env` olarak kopyalayin ve degerleri doldurun.
# GERCEK ANAHTARLARI ASLA .env.example ICINE YAZMAYIN — bu dosya repoya girer.

# --- AI saglayici (varsayilan: gemini) ---
# Ucretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model SABIT: gemini-2.5-flash (2.0-flash ucretsiz katmanda limite takiliyor)
GEMINI_MODEL=gemini-2.5-flash

# Opsiyonel diger saglayicilar
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Stock video (Pexels) ---
# Ucretsiz anahtar: https://www.pexels.com/api/
PEXELS_API_KEY=

# --- YouTube (henuz aktif degil) ---
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_PATH=
YOUTUBE_TOKEN_PATH=
YOUTUBE_CHANNEL_ID=

# --- Seslendirme (Edge-TTS, anahtar gerektirmez) ---
# Bos birakilirsa en-US-GuyNeural kullanilir
EDGE_TTS_VOICE=

# --- Bildirimler (opsiyonel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_WEBHOOK_URL=
